# Configuración para Google Cloud Platform
# ==========================================

# Redis Configuration
REDIS_URL=redis://:password@10.0.0.5:6379/0  # IP interna de GCP
REDIS_HOST=10.0.0.5  # IP interna de Memorystore o VM
REDIS_PORT=6379
REDIS_PASSWORD=tu_password_seguro
REDIS_DB=0

# Google Cloud Settings
GOOGLE_CLOUD_PROJECT=gcp-vm-357012
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Django Settings para Producción
DEBUG=False
ALLOWED_HOSTS=tu-dominio.com,*.appspot.com
SECRET_KEY=tu_secret_key_super_seguro

# Database (Cloud SQL)
DATABASE_URL=postgres://user:password@/dbname?host=/cloudsql/proyecto:region:instancia

# Storage (Cloud Storage)
GS_BUCKET_NAME=gcp-vm-357012-adb-storage
GS_PROJECT_ID=gcp-vm-357012

# Logging
GOOGLE_CLOUD_LOGGING=True